PORT=4001

# development → dev.james_receipts | production → prod.james_receipts
APP_ENV=development

INGEST_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Render fornece esta variável automaticamente quando o banco é ligado ao serviço.
DATABASE_URL=postgresql://usuario:senha@host:5432/studio_rj

# URL do frontend James no Vercel (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:9003,https://studio-riscos-digitais.vercel.app

DUPLICATE_WINDOW_MS=5000
FLUSH_INTERVAL_MS=10000
